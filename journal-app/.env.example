# Copy this file to ".env" and fill in your own values.
# Expo only exposes variables prefixed with EXPO_PUBLIC_ to the app.
#
# NOTE: these values are bundled into the app, so this setup is intended for a
# PERSONAL app you run yourself. For a published app, move these calls behind a
# small backend so the keys never ship to the device.

# Notion internal integration token (starts with "ntn_" or "secret_").
# Create one at https://www.notion.so/my-integrations and share the Journal
# database page with the integration so it has access.
EXPO_PUBLIC_NOTION_TOKEN=

# The Journal database ID (already created for you). Override only if you
# recreate the database.
EXPO_PUBLIC_NOTION_DATABASE_ID=72699b7865ae4b22beb360b7b95b5dfd

# Anthropic API key for weekly insights. Get one at https://console.anthropic.com
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# Model used for weekly insights (optional override).
EXPO_PUBLIC_ANTHROPIC_MODEL=claude-opus-4-8
