# Copy to .env and fill in. Everything is optional except your location.
PORT=8080
# MOCK=1 shows sample weather, calendar and placeholder art (no keys needed)
MOCK=0

# --- Location & units -----------------------------------------------------------
LOCATION_NAME=Home
LATITUDE=51.5072
LONGITUDE=-0.1276
UNITS=metric            # metric | imperial (imperial also switches to a 12h clock)
UI_SCALE=1              # enlarge text/panel for viewing from across the room (0.5–3)

# --- Google Calendar --------------------------------------------------------------
# Google Calendar > Settings > (your calendar) > Integrate calendar >
# "Secret address in iCal format". Comma-separate several; optional "Label|" prefix.
CALENDAR_ICS_URLS=
CALENDAR_DAYS=7

# --- Art ---------------------------------------------------------------------------
ART_SOURCE=ai           # ai | photos | alternate | mock
IMAGE_PROVIDER=gemini   # gemini | openai
ART_ORIENTATION=auto    # auto (follow the screen) | landscape | portrait
GEMINI_API_KEY=
OPENAI_API_KEY=
# Claude writes each image prompt from the weather/season/time/calendar.
# Without this key a simple built-in template is used.
ANTHROPIC_API_KEY=
PROMPT_MODEL=claude-sonnet-5-5
# Image models get retired; if the setup page says "model unavailable", set a current one here.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# OPENAI_IMAGE_MODEL=gpt-image-2
# OPENAI_IMAGE_QUALITY=medium   # low | medium | high (cost rises steeply with quality)
ART_STYLE=museum-quality fine art, painterly, rich texture, calm and contemplative, suitable for a living-room wall
ART_USE_CALENDAR=1      # 0 = never send event titles to the prompt writer
ART_SCHEDULE=daily@07:00   # or every:180 (minutes)
ART_ROTATE_MINUTES=15      # saved pieces rotate in between, at no cost
# Spend controls: every new piece is a paid API call (~$0.02-0.05 each, Nov 2026).
ART_MAX_PER_DAY=3          # includes "Generate now" taps
ART_MONTHLY_BUDGET=        # estimated USD per month, e.g. 5; empty = no cap
# ART_COST_PER_IMAGE=0.04  # used for the estimate; defaults by provider/quality
ART_KEEP=60
QUIET_HOURS=23-6        # no generation, dimmed clock-only display; "off" to disable

# --- Google Photos (Picker API) -----------------------------------------------------
# Google Cloud console > APIs & Services: enable "Photos Picker API", create an
# OAuth client (type "Web application") with the redirect URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/photos/callback
